# ==============================================================================
# Trinova Integration & Document-Signing Service - Environment Configuration
# ==============================================================================
# Security Notice: NEVER commit actual credentials, tokens, or private secrets to version control.
# Reference: context/05_data_security_context.md §4 (Server-side secret isolation)
# Reference: context/06_testing_deployment_context.md §13 (Sanitized configuration template)
# ==============================================================================

# Application Environment & Network
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Server-to-Server Authentication (Bearer / X-Trinova-API-Key)
# ------------------------------------------------------------------------------
# Scoped API credentials for authorized Trinova ⇄ Sloane communication.
# In production, these must be high-entropy random tokens (min 32 chars).
SLOANE_API_KEY=replace_with_high_entropy_production_readwrite_key
SLOANE_READONLY_API_KEY=replace_with_high_entropy_production_readonly_key
# (SLON_API_KEY and SLON_READONLY_API_KEY are accepted as alternative names.)
# This key is Sloane's own. It is NEVER sent to TriNova.

# ------------------------------------------------------------------------------
# Owner sign-in (the only login Sloane has; there are no default accounts)
# ------------------------------------------------------------------------------
SLON_OWNER_EMAIL=replace_with_owner_email
# bcrypt hash of the owner's password. Make one with:
#   node -e "import('bcryptjs').then(b=>console.log(b.default.hashSync('YOUR-PASSWORD',10)))"
# Put it in single quotes if you use a shell, because it contains $ characters.
SLON_OWNER_PASSWORD_HASH=replace_with_bcrypt_hash_of_the_owner_password
# Random secret (min 32 chars) that signs short-lived document download links.
SLON_TOKEN_SECRET=replace_with_random_secret_min_32_chars

# ------------------------------------------------------------------------------
# TriNova portal (live clients). READ ONLY: Sloane never changes anything in TriNova.
# ------------------------------------------------------------------------------
# No default. Without it Sloane does not call TriNova and shows only clients added in Sloane.
# The key that used to be committed in this repository must be rotated and replaced here.
TRINOVA_API_KEY=replace_with_the_new_trinova_api_key
TRINOVA_API_URL=https://portal.trinovaaccounting.co.uk/api/v1
TRINOVA_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# Where Sloane saves its data (choose ONE of the first two, or the data is lost on every deploy)
# ------------------------------------------------------------------------------
# A) A mounted volume (Railway: attach a Volume at /data). Database file, uploaded
#    documents and the Outlook vault are all kept inside it.
#    On Railway, RAILWAY_VOLUME_MOUNT_PATH is used automatically if this is not set.
SLOANE_DATA_DIR=/data
# B) Postgres instead of the SQLite file. Documents and the Outlook vault still need the volume.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SSL=true
# Optional: move one thing on its own (these override SLOANE_DATA_DIR)
# SLOANE_DB_PATH=/data/sloane.db
# OUTLOOK_VAULT_PATH=/data/outlook-vault.json
# (STORAGE_ROOT_PATH further down moves the uploaded documents.)
# Needs Node.js 22.13 or newer for the built-in SQLite database.

# Example clients, tasks and deadlines for demos. Leave UNSET for real use.
# SLOANE_DEMO_DATA=true

# Extra web addresses allowed to call the API, comma-separated (optional)
# CORS_ALLOWED_ORIGINS=https://your-site.example

# ------------------------------------------------------------------------------
# Outlook (optional; read-only calendar and flagged emails)
# ------------------------------------------------------------------------------
# From your Microsoft Entra (Azure) app registration.
OUTLOOK_CLIENT_ID=replace_with_entra_application_client_id
OUTLOOK_CLIENT_SECRET=replace_with_entra_client_secret
# Must exactly match the redirect URI registered in Microsoft.
OUTLOOK_REDIRECT_URI=https://your-site.example/api/v1/integrations/outlook/callback
# Optional. Defaults to the common tenant.
# OUTLOOK_TENANT_ID=replace_with_tenant_id
# 64 hex characters. Encrypts the saved Outlook tokens. If it changes, Outlook must be reconnected.
OUTLOOK_TOKEN_ENC_KEY=replace_with_64_hex_characters

# ------------------------------------------------------------------------------
# Companies House API Integration
# ------------------------------------------------------------------------------
# Held exclusively server-side. Never expose to client applications or browsers.
# Reference: context/04_backend_integration_context.md §9
COMPANIES_HOUSE_API_KEY=replace_with_registered_companies_house_live_key
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk

# ------------------------------------------------------------------------------
# Trinova Document Signing Service (Documenso Community Edition AGPL-3.0)
# ------------------------------------------------------------------------------
# Evaluated and approved per context/signing-provider-evaluation.md
# NOTE: today Sloane only RECORDS signing requests; it does not send them to Documenso or to signers.
SIGNING_PROVIDER=documenso
SIGNING_API_URL=https://signing.trinova.internal/api/v1
SIGNING_API_KEY=replace_with_documenso_service_api_key
SIGNING_WEBHOOK_SECRET=replace_with_high_entropy_hmac_sha256_webhook_secret

# ------------------------------------------------------------------------------
# Document Storage Driver Configuration
# ------------------------------------------------------------------------------
# Uploaded documents go into SLOANE_DATA_DIR/documents. Only set STORAGE_ROOT_PATH to put
# them somewhere else (it overrides SLOANE_DATA_DIR for documents).
# Reference: context/05_data_security_context.md §5
# STORAGE_ROOT_PATH=/data/documents
DOCUMENT_MAX_SIZE_BYTES=15728640
STORAGE_PRESIGNED_TOKEN_SECRET=replace_with_secure_hmac_token_signing_secret

# ------------------------------------------------------------------------------
# Outbound Email & Notification Delivery
# ------------------------------------------------------------------------------
# In staging/test: MAIL_SANDBOX_MODE must remain 'true' to intercept customer emails.
# In production: Configure verified transactional SMTP host and credentials.
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=replace_with_production_smtp_username
MAIL_PASS=replace_with_production_smtp_password
MAIL_FROM=portal@trinova.co.uk
MAIL_SANDBOX_MODE=false

# ------------------------------------------------------------------------------
# Anthropic Claude AI Integration (Sloane Assistant)
# ------------------------------------------------------------------------------
# Held exclusively server-side. Never expose to client applications or browsers.
# Reference: Prompt Section 18-20, 30 & context/05_data_security_context.md
ANTHROPIC_API_KEY=replace_with_anthropic_api_key_sk_ant
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TIMEOUT_MS=15000
ANTHROPIC_MAX_TOKENS=1500
AI_RATE_LIMIT_MAX=60
AI_RATE_LIMIT_WINDOW_MS=60000
# ------------------------------------------------------------------------------
# Google Gemini AI Integration (Redundant / Primary AI Provider)
# ------------------------------------------------------------------------------
# Optional alternative to Anthropic Claude. Automatically fails over or primary.
# Get free key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_google_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
AI_PROVIDER=auto
